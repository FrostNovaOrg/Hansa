# Lane worktrees: checkouts of other repositories that happen to live inside the desk.
.worktrees/

# The open hand-edit window. A live token, not history: the record of what happened
# inside it is the append-only state/hand-ledger.md, which IS committed. A window
# restored by a checkout would count as open, which is the one thing it must not do.
state/.hand-window

# Previous versions of state files, kept by `bellhop state` so an overwrite is recoverable.
# They are local safety copies, not desk history: the history is in git.
state/.previous/

# Lane locks. A lock that reached a commit would make the lane look busy forever in
# every fresh clone of the desk, with no worker anywhere to release it.
bells/.locks/

# Raw worker output: large, noisy, and reproducible from the receipt. The .json result
# files and the .prompt.md files beside them stay tracked -- they carry the numbers the
# receipt footer is built from and the exact words the worker was given.
bells/logs/*.log

__pycache__/
*.pyc
state/.sentinel/
state/.daily-clear-*
state/.brief-sent
state/.release-*.json
