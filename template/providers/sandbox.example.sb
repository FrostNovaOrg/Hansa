;; Minimal deny-by-default sandbox profile for a lane worker (macOS seatbelt).
;;
;; Applied through the desk's `sandbox_wrapper`, which on macOS is:
;;     "sandbox_wrapper": "sandbox-exec -f {profile}"
;; and on the lane:
;;     "sandbox_profile": "providers/lane-api.sb"
;; `{profile}` is replaced with the profile's absolute path and the result is prepended
;; to the worker command.
;;
;; OTHER PLATFORMS SUBSTITUTE THEIR OWN WRAPPER. Nothing in Bellhop parses this file --
;; it is handed to whatever `sandbox_wrapper` names. On Linux that is bubblewrap
;; ("bwrap --ro-bind / / --bind {profile} ..." with a profile of your own shape) or
;; firejail ("firejail --profile={profile}"); on a machine with neither, leave
;; `sandbox_profile` unset and say in the lane rules that the CLI's own gate is the only
;; one. What must not happen is a lane that names a profile and runs without one: a
;; worker that ran unsandboxed leaves the same receipt as one that did not, which is why
;; a named profile that is not on disk refuses the launch.
;;
;; Replace every <...> below before use. Absolute paths only; seatbelt does not expand
;; `~` or environment variables.

(version 1)

;; Everything is refused unless a rule below allows it.
(deny default)

;; Say why, in the system log, rather than failing silently. A worker that was stopped by
;; the sandbox and a worker whose command simply did nothing look the same otherwise.
(deny default (with report))

;; -- no network -------------------------------------------------------------
;; First, because it is the one that matters most and the one a later edit is likeliest
;; to loosen by accident. A worker has no business fetching anything: the packet, the
;; repository and the toolchain are all local.
(deny network*)

;; -- process ----------------------------------------------------------------
(allow process-exec)
(allow process-fork)
(allow signal (target self))
(allow sysctl-read)
(allow mach-lookup)

;; -- read: the toolchain, and nothing else outside the worktree -------------
(allow file-read*
  (subpath "/usr/bin")
  (subpath "/usr/lib")
  (subpath "/usr/share")
  (subpath "/bin")
  (subpath "/sbin")
  (subpath "/opt/homebrew")          ; the toolchain this desk builds with
  (subpath "/System/Library")
  (subpath "/Library/Developer")
  (literal "/dev/null")
  (literal "/dev/urandom")
  (subpath "<DESK ROOT>")            ; the packet, the rules, the state files
  (subpath "<LANE WORKTREE>"))

;; -- write: the lane worktree, the receipt, and scratch ---------------------
;; The lane worktree is a linked one, so its index lives in the main repository's `.git`.
;; Leaving that out is what makes `git commit` fail inside the sandbox with an error
;; about a lock file, several turns after the worker started.
(allow file-write*
  (subpath "<LANE WORKTREE>")
  (subpath "<MAIN REPOSITORY>/.git")
  (subpath "<DESK ROOT>/receipts")
  (subpath "<DESK ROOT>/bells/logs")
  (subpath "/private/tmp")
  (subpath "/private/var/folders"))  ; TMPDIR

;; The desk's own git is not on either list. Workers do not touch it: the archive is the
;; coordinator's, with gates a worker does not carry.
