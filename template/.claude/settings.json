{
  "permissions": {
    "allow": [
      "Bash(bellhop *)",
      "Bash(./bin/bellhop *)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "sh .claude/hooks/session-start.sh" }
        ]
      }
    ]
  }
}
