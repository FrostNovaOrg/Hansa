#!/usr/bin/env python3
"""A fake `srt --settings FILE -- COMMAND...`: keeps the settings it was given (FAKE_SRT_RECORD), then runs the
command as a child, as srt does, and exits with its code (128 + n for a child killed by signal n, as a shell
reports it). It passes no signal on. FAKE_SRT_KILL: once FAKE_CODEX_RECORD exists (codex has started), kill
itself with this signal number."""
import json
import os
import signal
import subprocess
import sys
import time

argv = sys.argv[1:]
assert argv[0] == "--settings" and argv[2] == "--", argv
if os.environ.get("FAKE_SRT_RECORD"):
    with open(os.environ["FAKE_SRT_RECORD"], "w") as f:
        json.dump({"settings": json.load(open(argv[1])), "command": argv[3:], "pid": os.getpid()}, f)
child = subprocess.Popen(argv[3:])
if os.environ.get("FAKE_SRT_KILL"):
    end = time.time() + 30
    while time.time() < end and not os.path.exists(os.environ.get("FAKE_CODEX_RECORD") or ""):
        time.sleep(0.05)
    os.kill(os.getpid(), int(os.environ["FAKE_SRT_KILL"]))
    time.sleep(30)
code = child.wait()
sys.exit(128 - code if code < 0 else code)
